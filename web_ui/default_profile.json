{
  "theme": "cyberpunk-neon",
  "env": [],
  "--llm-keepalive": "0",
  "--ollama-load-timeout-seconds": 60,
  "--llm-backend-type": "direct",
  "hermes": {
    "enabled": false,
    "port": 8642,
    "host": "127.0.0.1",
    "api_key": "",
    "model_name": "qwen3.5:9b",
    "filler_enabled": true,
    "filler_phrases": [
      "one moment",
      "let me check",
      "thinking...",
      "give me a second"
    ],
    "compress_context_every_n_turns": 20,
    "log_level": "verbose",
    "filler_delay_ms": 1500,
    "read_timeout_s": 0
  },
  "llm_request_timeout_s": {
    "hermes": 0,
    "ollama": 120,
    "vllm": 120,
    "llama.cpp": 120,
    "chat-completions": 120,
    "responses-api": 30,
    "mlx-lm": 120,
    "transformers": 120
  },
  "--mode": "realtime",
  "--stt": "parakeet-tdt",
  "--llm-backend": "responses-api",
  "--tts": "qwen3",
  "--device": null,
  "--local-mac-optimal-settings": false,
  "--log-level": "debug",
  "--enable-live-transcription": true,
  "--live-transcription-update-interval": 0.5,
  "--live-transcription-min-silence-ms": 500,
  "--enable-llm-proxy": false,
  "--llm-proxy-connect-timeout-s": 10,
  "--num-pipelines": 1,
  "--thresh": 0.5,
  "--sample-rate": 16000,
  "--min-silence-ms": 64,
