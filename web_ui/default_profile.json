  "_enabled_flags": [
    "--mode",
    "--stt",
    "--llm-backend",
    "--tts",
    "--log-level",
    "--thresh",
    "--smart-turn",
    "--parakeet-tdt-model-name",
    "--parakeet-tdt-device",
    "--parakeet-tdt-language",
    "--model-name",
    "--responses-api-base-url",
    "--responses-api-disable-thinking",
    "--responses-api-max-tokens",
    "--responses-api-warmup-system-prompt",
    "--qwen3-tts-model-name",
    "--qwen3-tts-attn-implementation",
    "--qwen3-tts-speaker"
