  "--qwen3-tts-model-name": "Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice",
  "--qwen3-tts-device": "cuda",
  "--qwen3-tts-dtype": "auto",
  "--qwen3-tts-attn-implementation": "flash_attention_2",
  "--qwen3-tts-backend": "ggml",
  "--qwen3-tts-ref-audio": "",
  "--qwen3-tts-ref-text": "",
  "--qwen3-tts-speaker": "Ono_Anna",
  "--qwen3-tts-instruct": "",
