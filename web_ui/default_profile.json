  "--audio-enhancement": false,
  "--enable-realtime-transcription": false,
  "--realtime-processing-pause": 0.5,
  "--speculative-reopen-ms": 1000,
  "--unanswered-reopen-ms": 7000,
  "--short-segment-merge-ms": 0,
  "--smart-turn": true,
  "--smart-turn-model-path": "",
  "--smart-turn-threshold": 0.5,
  "--smart-turn-max-wait-ms": 2000,
  "--smart-turn-incomplete-delay-ms": 600,
  "--smart-turn-cpu-count": 1,
  "--parakeet-tdt-model-name": "",
  "--parakeet-tdt-device": "cpu",
  "--parakeet-tdt-compute-type": "float16",
  "--parakeet-tdt-language": "",
